# Copy this file to .env and fill in your own values before running/deploying.

# Any long random string - used to sign login sessions (JWT tokens).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on (most hosting providers set this automatically).
PORT=3000

# Where the SQLite database file lives. Leave unset for local development
# (it will default to db/inventory.sqlite). On a host with a persistent
# disk/volume, point this at a path inside it so data survives redeploys.
# Ignored entirely if DATABASE_URL (below) is set.
# DATABASE_PATH=/data/inventory.sqlite

# If set, the app uses PostgreSQL instead of SQLite -- this is how Render's
# managed Postgres databases (and most other hosts) identify themselves.
# Leave unset for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Default admin account created the first time you run db/seed.py.
# Change this password immediately after your first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
